@page
@model PassengersModel
@{ ViewData["Title"] = "Пассажиры"; }

<h1 class="h4 mb-3">Пассажиры <span class="text-muted fs-6">@Model.Rows.Count</span></h1>

<form method="post" asp-page-handler="Create" class="row g-2 align-items-end border rounded bg-white p-3 mb-3">
    <div class="col-md-4"><label class="form-label small">Имя</label><input name="name" class="form-control" required /></div>
    <div class="col-md-3"><label class="form-label small">Телефон</label><input name="phone" class="form-control" placeholder="0555 12 34 56" required /></div>
    <div class="col-md-auto"><button class="btn btn-primary">Добавить пассажира</button></div>
    <div class="col-12 text-muted small">Пассажиры обычно регистрируются сами: открывают бота и делятся номером. Водителей заводите на странице <a asp-page="/Drivers">«Водители»</a>.</div>
</form>

<div class="table-responsive">
<table class="table table-sm align-middle bg-white">
    <thead><tr><th>Имя</th><th>Телефон</th><th>Telegram</th><th>Маршрут и место</th><th>Записать / изменить</th><th></th></tr></thead>
    <tbody>
    @foreach (var (u, m) in Model.Rows)
    {
        <tr>
            <td>@u.Name</td>
            <td class="text-nowrap">+@u.Phone</td>
            <td>@(u.TelegramId is null ? "—" : "✓")</td>
            <td>
                @if (m is null) { <span class="text-muted">—</span> }
                else
                {
                    <div>@m.Route.Name, @m.Stop.Name</div>
                    <div class="small">
                        @(m.Morning && m.Evening ? "утро и вечер" : m.Morning ? "утро" : "вечер") ·
                        @if (m.Status == MembershipStatus.Regular) { <span class="text-success">место @(m.SeatNumber?.ToString() ?? "—"), с @WorkCalendar.Format(m.From)</span> }
                        else { <span class="text-warning">в очереди</span> }
                    </div>
                    <div class="d-flex gap-1 mt-1">
                        @if (m.Status == MembershipStatus.Waitlist)
                        {
                            <form method="post" asp-page-handler="Promote" class="d-flex gap-1">
                                <input type="hidden" name="membershipId" value="@m.Id" />
                                <input name="seat" type="number" min="1" class="form-control form-control-sm" style="width:5rem" placeholder="место" />
                                <button class="btn btn-sm btn-outline-success text-nowrap">Дать место</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Leave" onsubmit="return confirm('Снять с маршрута?')"><input type="hidden" name="userId" value="@u.Id" /><button class="btn btn-sm btn-outline-secondary">Снять</button></form>
                    </div>
                }
            </td>
            <td>
                <form method="post" asp-page-handler="Join" class="d-flex gap-1">
                    <input type="hidden" name="userId" value="@u.Id" />
                    <select name="routeStop" class="form-select form-select-sm">
                        @foreach (var s in Model.Stops)
                        {
                            <option value="@s.RouteId:@s.Id" selected="@(m?.StopId == s.Id)">@s.Route.Name — @s.Name</option>
                        }
                    </select>
                    <select name="dirs" class="form-select form-select-sm" style="width:auto">
                        <option value="both">утро+вечер</option><option value="morning">утро</option><option value="evening">вечер</option>
                    </select>
                    <input name="seat" type="number" min="1" class="form-control form-control-sm" style="width:5rem" placeholder="место" title="Номер места; пусто — первое свободное" />
                    <button class="btn btn-sm btn-outline-primary">OK</button>
                </form>
            </td>
            <td>
                <form method="post" asp-page-handler="MakeDriver" onsubmit="return confirm('Сделать водителем? Он будет снят с маршрута как пассажир.')">
                    <input type="hidden" name="userId" value="@u.Id" />
                    <button class="btn btn-sm btn-link text-nowrap">→ водитель</button>
                </form>
            </td>
        </tr>
    }
    @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="text-muted">Пока нет пассажиров.</td></tr> }
    </tbody>
</table>
</div>
