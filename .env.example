ADMIN_PASSWORD=change-me
# Токен от @BotFather. Пусто — бот выключен, Mini App в Telegram не откроется.
BOT_TOKEN=
# Публичный HTTPS-адрес приложения: адрес туннеля Cloudflare или свой домен. Бот ставит по нему кнопку Mini App.
PUBLIC_URL=
# Только для постоянного туннеля (профиль tunnel-named): токен из Cloudflare Zero Trust → Networks → Tunnels.
TUNNEL_TOKEN=
